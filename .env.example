# Server Port (Render sets this automatically, but required for local dev)
PORT=3000

# MongoDB Connection String (Atlas or self-hosted MongoDB)
# Replace with your actual MongoDB connection URI:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/waha_whatsapp?retryWrites=true&w=majority

# Security: Webhook Secret Token (Ensure only your WAHA instance can post data)
# WAHA me header or query ?secret=YOUR_TOKEN pass karein
WEBHOOK_SECRET=my_waha_secure_token_123

# Security: Admin API Key (Required to access /messages)
# Access via: https://your-app.onrender.com/messages?key=my_admin_secret_key_456
ADMIN_API_KEY=my_admin_secret_key_456

