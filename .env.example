# ==============================================================
# Server Configuration
# ==============================================================
# Port for local development (Render assigns this automatically)
PORT=3000

# ==============================================================
# Database Configuration
# ==============================================================
# MongoDB Connection URI (Atlas Cluster or self-hosted MongoDB)
# Format: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/waha_api?retryWrites=true&w=majority&appName=Cluster0

# ==============================================================
# Security & Authentication
# ==============================================================
# Webhook Secret Token to authenticate incoming requests from WAHA
# Pass as query param: ?secret=YOUR_TOKEN or header: x-api-key: YOUR_TOKEN
WEBHOOK_SECRET=your_waha_webhook_secret_here

# Master API Key required to view stored messages and use outbound endpoints
# Pass as query param: ?key=YOUR_KEY or header: x-api-key: YOUR_KEY
ADMIN_API_KEY=your_admin_secret_key_here

# ==============================================================
# WAHA Server Configuration (Outbound & Auto-Reply)
# ==============================================================
# Base URL of your self-hosted WAHA instance
WAHA_BASE_URL=http://xxxxxxxxx:3000

# WAHA API Key (if configured in WAHA environment, otherwise leave blank)
WAHA_API_KEY=your_waha_api_key_here

# WAHA WhatsApp session name (default is 'default')
WAHA_SESSION=default

# Auto-reply cooldown in minutes per user (prevents spamming if user sends multiple 'hi')
AUTO_REPLY_COOLDOWN_MINUTES=10

